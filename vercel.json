{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node standalone/build-maurimax.mjs && mkdir -p .vercel-static && cp standalone/maurimax.html .vercel-static/index.html",
  "outputDirectory": ".vercel-static",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
